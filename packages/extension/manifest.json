{
  "manifest_version": 3,
  "key": "",
  "name": "Chromanche",
  "short_name": "Chromanche",
  "version": "0.13.0",
  "description": "Lets a local MCP server drive your logged-in Chrome from an MCP-capable client. Loopback-only. No telemetry.",
  "author": "Marco Bazzani",
  "homepage_url": "https://github.com/marcobazzani/Chromanche",
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "storage",
    "alarms",
    "identity",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": "icons/icon-128.png"
  },
  "icons": {
    "128": "icons/icon-128.png"
  }
}
